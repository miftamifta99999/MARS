# Purpose: First program, Hello World 
.text    
# Define the program instructions. 
main:    
li $v0,4       
la $a0, greeting  
syscall           
li $v0, 10   
syscall   
.data    
# Label to define the main program. 
# Load 4 into $v0 to indicate a print string. 
# Load the address of the greeting into $a0. 
# Print greeting.  The print is indicated by 
# $v0 having a value of 4, and the string to    
# print is stored at the address in $a0.  
# Load a 10 (halt) into $v0. 
# The program ends. 
# Define the program data. 
greeting: .asciiz "Hello World" #The string to print. 
